---
import { apiFetch } from "../../lib/api/client";

// Tipo para las features del API
interface ApiFeature {
  feature_id: number;
  feature_key: string;
  feature_name: string;
  feature_description: string;
  feature_category: string;
  base_price: number;
  included_by_default: boolean;
  discount_percentage: number;
  final_price: number;
}

// Tipo para los tiers del API
interface ApiTier {
  tier_id: number;
  tier_name: string;
  tier_base_price: number;
  max_menus: number;
  max_restaurants: number;
  tier_description: string;
  features: ApiFeature[];
}

interface ApiResponse {
  success: boolean;
  data: ApiTier[];
  message: string;
}

// Tipo para mostrar en el componente
interface DisplayPlan {
  id: number;
  name: string;
  price: number;
  description: string;
  features: ApiFeature[];
  isPopular: boolean;
  ctaText: string;
}

let plans: DisplayPlan[] = [];
let error: string | null = null;

// Función para capitalizar y formatear el nombre del tier
function formatTierName(tierName: string): string {
  const nameMap: Record<string, string> = {
    'free': 'Gratis',
    'basic': 'Básico',
    'pro': 'Pro',
    'pro +': 'Pro+'
  };
  return nameMap[tierName.toLowerCase()] || tierName;
}

// Función para determinar el CTA según el tier
function getCtaText(tierName: string): string {
  if (tierName.toLowerCase() === 'free') return 'Comenzar gratis';
  if (tierName.toLowerCase() === 'pro +') return 'Contactar';
  return 'Comenzar ahora';
}

try {
  const response = await apiFetch<ApiResponse>({
    path: "/subscriptions/tiers",
    method: "GET",
  });
  
  if (response.success && response.data) {
    // Transformar los datos del API al formato de visualización
    plans = response.data
      .filter((tier) => tier.tier_name.toLowerCase() !== 'pro +') // Excluir el plan Pro+
      .map((tier) => ({
        id: tier.tier_id,
        name: formatTierName(tier.tier_name),
        price: tier.tier_base_price,
        description: tier.tier_description,
        features: tier.features.filter(f => f.feature_name), // Filtrar features sin nombre
        isPopular: tier.tier_name.toLowerCase() === 'basic', // El plan Básico es el más popular
        ctaText: getCtaText(tier.tier_name)
      }));
    
    // Ordenar planes por precio
    plans.sort((a, b) => a.price - b.price);
  }
} catch (err) {
  console.error("Error fetching plans:", err);
  error = "No pudimos cargar los planes. Por favor intenta más tarde.";
}
---

<section
  id="pricing"
  class="py-12 md:py-16 px-6 max-w-7xl mx-auto"
>
  <div class="text-center mb-14">
    <h2 class="text-3xl md:text-4xl font-semibold tracking-tight mb-4">
      Precios simples y transparentes
    </h2>
    <p class="text-muted max-w-2xl mx-auto">
      Elige el plan que mejor se adapte a tu restaurante. Sin costos ocultos ni sorpresas.
    </p>
  </div>

  {error ? (
    <div class="text-center text-red-600 dark:text-red-400 p-6 border border-red-200 dark:border-red-800 rounded-xl max-w-2xl mx-auto">
      {error}
    </div>
  ) : (
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 max-w-6xl mx-auto">
      {plans.map((plan) => (
        <div 
          class:list={[
            "pricing-card",
            { "pricing-card-popular": plan.isPopular }
          ]}
        >
          {plan.isPopular && (
            <div class="pricing-badge">
              Más popular
            </div>
          )}

          <div class="pricing-header">
            <h3 class="pricing-title">{plan.name}</h3>
            <p class="pricing-description">{plan.description}</p>
            
            <div class="pricing-price">
              <span class="pricing-currency">$</span>
              <span class="pricing-amount">{plan.price.toLocaleString('es-CL')}</span>
              <span class="pricing-period">/mes</span>
            </div>
          </div>

          <div class="pricing-features">
            <ul class="pricing-feature-list">
              {plan.features.map((feature) => (
                <li class="pricing-feature-item">
                  <svg 
                    class="pricing-feature-icon" 
                    fill="none" 
                    viewBox="0 0 24 24" 
                    stroke="currentColor"
                  >
                    <path 
                      stroke-linecap="round" 
                      stroke-linejoin="round" 
                      stroke-width="2" 
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  <span>{feature.feature_name}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pricing-footer">
            <a 
              href={plan.ctaText === 'Contactar' ? '/contacto' : '/app/register'}
              class:list={[
                "pricing-cta",
                { "pricing-cta-primary": plan.isPopular }
              ]}
            >
              {plan.ctaText}
            </a>
            {plan.price > 0 && (
              <p class="text-xs text-muted mt-3">
                Pago dentro de la plataforma después del registro
              </p>
            )}
          </div>
        </div>
      ))}
    </div>
  )}

  {/* Disclaimer para planes personalizados */}
  <div class="mt-12 max-w-4xl mx-auto">
    <div class="bg-[var(--color-bg)] border-2 border-[var(--color-accent)] rounded-2xl p-8 text-center shadow-lg">
      <div class="text-2xl mb-3">💼</div>
      <h3 class="text-xl font-semibold mb-3 text-[var(--color-text)]">
        ¿Necesitas algo más personalizado?
      </h3>
      <p class="text-muted mb-5 max-w-2xl mx-auto">
        Si tienes una cadena de restaurantes o necesitas funcionalidades específicas para tu negocio, conversemos.
      </p>
      <a 
        href="https://wa.me/56912345678?text=Hola,%20me%20interesa%20un%20plan%20personalizado%20de%20MenuPro" 
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] text-white px-6 py-3 rounded-lg font-medium transition"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Contactar por WhatsApp
      </a>
      <p class="text-muted text-xs mt-4">Acordamos funcionalidades, personalización y precio según tus necesidades</p>
    </div>
  </div>
  
  {/* Nota adicional */}
  <div class="text-center mt-8 text-muted text-sm">
    <p>💳 Sin tarjeta de crédito requerida para probar • 🔒 Cancela cuando quieras</p>
  </div>
</section>

---
import "../../styles/global.css";

export const prerender = false;
const target = "/app/dashboard";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<title>Redireccionando…</title>
	</head>
	<body class="min-h-screen flex items-center justify-center bg-white text-neutral-900 dark:bg-neutral-950 dark:text-neutral-50">
		<div class="space-y-3 text-center">
			<p class="text-sm text-muted">Redireccionando al panel…</p>
			<a class="btn-primary inline-flex items-center justify-center px-4 py-2 rounded-lg font-semibold" href={target}>Ir al panel</a>
		</div>
		<script define:vars={{ target }}>
			window.location.replace(target);
		</script>
	</body>
</html>

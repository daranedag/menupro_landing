---
import PrivateLayout from "../../../app/layouts/PrivateLayout.astro";
import menusClientUrl from "./menus.client.js?url";

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL || "http://localhost:3000";
export const prerender = false;
---

<PrivateLayout title="Mis cartas | MenuPro" description="Gestiona tus cartas, secciones y platos.">
  <section id="menus-root" class="max-w-6xl mx-auto space-y-6" data-api-base={apiBaseUrl}>
    <div id="menus-header" class="flex items-center justify-between gap-3 flex-wrap">
      <div>
        <p class="text-sm text-muted">Cartas</p>
        <h1 class="text-3xl font-semibold">Mis cartas</h1>
        <p class="text-sm text-muted">Crea cartas, secciones y platos para tu restaurante.</p>
      </div>
      <div class="flex flex-col items-end gap-1">
        <a id="create-menu-btn" data-default-label="Crear nueva carta" href="/app/menus/nueva" class="btn-primary px-4 py-2 rounded-lg font-semibold">Crear nueva carta</a>
        <p id="menus-limit-hint" class="text-xs text-muted"></p>
      </div>
    </div>

    <div id="menus-loading" class="flex items-center gap-2 text-sm text-muted">
      <span class="loading-spinner" aria-hidden="true"></span>
      <span>Cargando cartas...</span>
    </div>

    <div id="menus-content" class="space-y-4 hidden">
      <div id="menus-alert" class="hidden rounded-lg border border-default bg-[var(--color-bg-soft)] p-4 text-sm"></div>
      <p id="menus-status" class="text-sm text-muted"></p>

      <div id="menus-list" class="space-y-4"></div>
    </div>
  </section>
</PrivateLayout>

<script type="module" src={menusClientUrl}></script>

<style is:inline>
  .loading-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(0,0,0,0.1);
    border-top-color: var(--color-accent, #7c3aed);
    border-radius: 9999px;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .generate-qr-btn[data-tooltip] {
    position: relative;
    overflow: visible;
  }

  .generate-qr-btn[data-tooltip]:hover::after,
  .generate-qr-btn[data-tooltip]:focus-visible::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 8px);
    right: 0;
    max-width: 240px;
    background: var(--color-bg-soft, #fff);
    color: inherit;
    border: 1px solid var(--color-border, rgba(0,0,0,0.1));
    box-shadow: 0 8px 16px rgba(0,0,0,0.12);
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 12px;
    line-height: 1.4;
    z-index: 10;
    white-space: normal;
  }

  .generate-qr-btn[data-tooltip]:hover::before,
  .generate-qr-btn[data-tooltip]:focus-visible::before {
    content: '';
    position: absolute;
    bottom: calc(100% + 2px);
    right: 12px;
    border-width: 6px 6px 0 6px;
    border-style: solid;
    border-color: var(--color-bg-soft, #fff) transparent transparent transparent;
    z-index: 11;
    filter: drop-shadow(0 -1px 1px rgba(0,0,0,0.08));
  }

  .section-card.dragging {
    opacity: 0.6;
    border-style: dashed;
  }
</style>
